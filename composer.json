{
    "name": "pieceofcake2/bake",
    "description": "Code generation console (bake) for CakePHP 2 applications",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "bake", "code generation", "scaffolding"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^1.1"
    },
    "autoload": {
        "classmap": ["Console/Command/"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Bake"
    }
}
