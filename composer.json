{
    "name": "pieceofcake2/bake",
    "description": "Bake plugin for CakePHP 2.x - Code generation tool",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "bake", "code generation", "scaffolding"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "*",
        "pieceofcake2/cakephp": "^2.11"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Bake"
    }
}
