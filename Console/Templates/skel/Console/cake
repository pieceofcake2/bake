if (!defined('DS')) {
    define('DS', DIRECTORY_SEPARATOR);
}

if (!defined('ROOT')) {
    define('ROOT', dirname(__DIR__, 2));
}

/**
 * Path to the Composer vendor directory, which holds "autoload.php".
 * Change this if "vendor-dir" is configured in composer.json.
 */
if (!defined('VENDORS')) {
    define('VENDORS', ROOT . DS . 'vendor' . DS);
}

if (!is_file(VENDORS . 'autoload.php')) {
    fwrite(
        STDERR,
        'Composer autoload file not found at "' . VENDORS . 'autoload.php". ' .
        'Please run "composer install" in the project root directory to install dependencies.' . PHP_EOL,
    );
    exit(1);
}
require_once VENDORS . 'autoload.php';

// Run the shells of this application unless another one is given with -app, -working or -root.
if (!array_intersect(['-working', '--working', '-app', '--app', '-root', '--root'], $argv)) {
    array_splice($argv, 1, 0, ['-working', dirname(__DIR__)]);
}

ShellDispatcher::run($argv);
